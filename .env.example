# OpenRouter is the only supported inference provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Screenshot-to-Code Studio

# Free-first, capability-aware routing. Do not silently route free jobs to paid models.
MODEL_POLICY=free_only
MODEL_PREFERRED_FAMILIES=nemotron,gemma
MAX_MODEL_RETRIES=3
MAX_REFINEMENT_ITERATIONS=3
REQUEST_TIMEOUT_MS=90000
MAX_CONCURRENT_JOBS_PER_PROJECT=1

# Required for a production deployment. A development-only fallback is used locally.
SESSION_SECRET=
PRIVATE_STORAGE_ROOT=.data/private
