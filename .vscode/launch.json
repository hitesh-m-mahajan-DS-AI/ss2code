{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SS2Code: Studio (web + worker)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/studio.mjs",
      "args": [
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
